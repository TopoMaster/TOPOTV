{
  "name": "topotv",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "web:dist": "npm run build && node tools/copy-web-release.cjs",
    "preview": "vite preview",
    "desktop:dist": "npm run build && npm ci --prefix desktop && npm run dist --prefix desktop",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug && cd .. && node tools/copy-android-release.cjs --debug",
    "android:release": "npm run android:sync && cd android && gradlew.bat --no-daemon assembleRelease && cd .. && node tools/copy-android-release.cjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.8.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.9",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  }
}
